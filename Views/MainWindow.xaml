<Window x:Class="BillNest.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BillNest - Workspace" Height="650" Width="800"
        WindowStartupLocation="CenterScreen" 
        AllowsTransparency="False" WindowStyle="SingleBorderWindow">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F0F2F5" Offset="0"/>
            <GradientStop Color="#D9E2EC" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,25">
            <Border Width="45" Height="45" Background="#3498db" CornerRadius="12">
                <TextBlock Text="B" Foreground="White" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="15,0">
                <TextBlock Text="BillNest" FontSize="26" FontWeight="ExtraBold" Foreground="#102A43"/>
                <TextBlock Text="Gestion de la base clients" FontSize="12" Foreground="#627D98"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="15" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Direction="270" Opacity="0.1" ShadowDepth="5"/>
            </Border.Effect>
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="5">
                        <TextBlock Text="Nom" Margin="0,0,0,5" Foreground="#486581" FontWeight="SemiBold" FontSize="11"/>
                        <TextBox x:Name="TxtNom" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#BCCCDC" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5">
                        <TextBlock Text="Prénom" Margin="0,0,0,5" Foreground="#486581" FontWeight="SemiBold" FontSize="11"/>
                        <TextBox x:Name="TxtPrenom" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#BCCCDC"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="5">
                        <TextBlock Text="Email" Margin="0,0,0,5" Foreground="#486581" FontWeight="SemiBold" FontSize="11"/>
                        <TextBox x:Name="TxtEmail" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#BCCCDC"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="5">
                        <TextBlock Text="Téléphone" Margin="0,0,0,5" Foreground="#486581" FontWeight="SemiBold" FontSize="11"/>
                        <TextBox x:Name="TxtTel" Height="35" VerticalContentAlignment="Center" Padding="10,0" BorderBrush="#BCCCDC"/>
                    </StackPanel>
                </Grid>

                <Button Content="ENREGISTRER" Margin="0,15,0,0"
                        Width="200" Height="40" Background="#3498db" Foreground="White" 
                        FontWeight="Bold" BorderThickness="0" Click="AjouterClient_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="RÉPERTOIRE CLIENTS" FontSize="12" FontWeight="Bold" Foreground="#627D98" Margin="5,0,0,10"/>

            <ListBox x:Name="ClientsListBox" Grid.Row="1"
                     ItemsSource="{Binding Clients}"
                     Background="Transparent" BorderThickness="0"
                     SelectionChanged="ClientsListBox_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ItemBorder" Background="White" CornerRadius="12" Margin="0,0,0,10" Padding="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.05" ShadowDepth="2"/>
                            </Border.Effect>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="🗑" 
                                        Width="35" Height="35" Background="#FEE2E2" Foreground="#EF4444" 
                                        BorderThickness="0" FontSize="16" Click="SupprimerClient_Click" Tag="{Binding}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40" Height="40" Background="#E0F2FE" CornerRadius="20" Grid.Column="0">
                                        <TextBlock Text="👤" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Prenom}" FontSize="14" FontWeight="Bold" Foreground="#102A43"/>
                                            <TextBlock Text="{Binding Nom}" FontSize="14" FontWeight="Bold" Foreground="#102A43" Margin="5,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Telephone}" FontSize="12" Foreground="#627D98"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Email}" VerticalAlignment="Center" 
                                               FontStyle="Italic" Foreground="#9BAEBF"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>